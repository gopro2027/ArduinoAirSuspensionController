{
  "name": "Waveshare ESP32-S3 Touch LCD 4.3 (ST7262 RGB + GT911)",
  "url": "https://www.waveshare.com/wiki/ESP32-S3-Touch-LCD-4.3",
  "vendor": "Waveshare",
  "frameworks": [
    "arduino"
  ],
  "connectivity": [
    "wifi",
    "bluetooth",
    "can"
  ],
  "build": {
    "core": "esp32",
    "variant": "esp32s3",
    "mcu": "esp32s3",
    "f_cpu": "240000000L",
    "f_flash": "80000000L",
    "flash_mode": "qio",
    "arduino": {
      "ldscript": "esp32s3_out.ld",
      "memory_type": "qio_opi"
    },
    "extra_flags": [
      "'-D ARDUINO_ESP32S3_DEV'",
      "'-D BOARD_HAS_PSRAM'",
      "'-D ARDUINO_USB_MODE=1'",
      "'-D ARDUINO_RUNNING_CORE=1'",
      "'-D ARDUINO_EVENT_RUNNING_CORE=1'",

      "'-D ARDUINO_USB_CDC_ON_BOOT=0'",

      "'-D ESP32_S3TOUCHLCD4P3'",

      "'-D DISPLAY_WIDTH=800'",
      "'-D DISPLAY_HEIGHT=480'"
    ]
  },
  "upload": {
    "flash_size": "8MB",

    "maximum_ram_size": 327680,

    "maximum_size": 3604480,
    "require_upload_port": true,
    "speed": 921600
  },
  "debug": {
    "openocd_board": "esp32s3.cfg"
  }
}
